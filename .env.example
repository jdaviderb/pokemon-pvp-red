# Copy to .env and fill in. .env is gitignored. Real shell env vars override these.

# --- Google OAuth (Sign in with Google) ---
# Create an OAuth 2.0 Client ID (type: Web application) at:
#   https://console.cloud.google.com/apis/credentials
# Under "Authorized redirect URIs" add EXACTLY (must match GOOGLE_REDIRECT_URI below):
#   http://localhost:3000/auth/oauth/google/callback
# (No "Authorized JavaScript origins" needed — the flow is server-side.)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# --- DEV mode ---
# Set to 1 to also show the username/password login + mount the dev console (/console) and the
# unauthenticated /battle/* endpoints. Leave UNSET in production (Google-only login).
# DEV=1

# --- optional ---
# Force the Secure flag on cookies. Defaults: on when DEV is unset (production), off in DEV
# (localhost is plain HTTP). Set COOKIE_SECURE=0 only if you must serve prod over plain HTTP.
# COOKIE_SECURE=1
# Stable session-cookie key (>=64 bytes); else a random one is persisted to .cookie_key.
# COOKIE_SECRET=
# Use Postgres instead of the default sqlite ./data.db:
# DATABASE_URL=postgres://user:pass@host/db
